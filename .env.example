# LLM provider — OpenAI-compatible. Either OpenAI direct or a gateway
# such as OpenRouter (key format sk-or-v1-...). One key drives both chat + embeddings.
OPENAI_API_KEY=sk-...
# Optional: gateway base URL. Leave unset/empty for api.openai.com.
# OpenRouter example:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=
# Model ids — must match the provider namespace (OpenRouter: "openai/..." prefix).
# Free-tier chat option (0 credits):
# CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
# Paid option: CHAT_MODEL=openai/gpt-4o
# EMBED_MODEL=openai/text-embedding-ada-002
# NOTE: changing EMBED_MODEL invalidates the existing ./chroma_db — re-ingest via POST /api/ingest.

# data.gov.sg real-time API — OPTIONAL (endpoints work keyless; key raises rate limits)
DGS_API_KEY=

# URA e-Services access key — Phase 4 only (F6 planning decisions)
URA_ACCESS_KEY=

