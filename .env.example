# LLM provider — OpenAI-compatible. Either OpenAI direct or a gateway
# such as OpenRouter (key format sk-or-v1-...). One key drives both chat + embeddings.
OPENAI_API_KEY=sk-...
# Optional: gateway base URL. Leave unset/empty for api.openai.com.
# OpenRouter example:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=
# Model ids — must match the provider namespace (OpenRouter: "openai/..." prefix).
# Free-tier chat option (0 credits):
# CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
# Paid options:
# CHAT_MODEL=openai/gpt-4o
# CHAT_MODEL=deepseek/deepseek-v4-flash-0731   (fast, cheap; needs OpenRouter credits)
# EMBED_MODEL=openai/text-embedding-ada-002
# NOTE: changing EMBED_MODEL invalidates the existing ./chroma_db — re-ingest via POST /api/ingest.

# data.gov.sg real-time API — OPTIONAL (endpoints work keyless; key raises rate limits)
DGS_API_KEY=

# URA e-Services access key — Phase 4 only (F6 planning decisions)
URA_ACCESS_KEY=

# Phase 2: clinic point injected into the RAG prompt. Defaults to the test
# clinic (context/config.py TEST_CLINIC) when unset. The snapshot is served
# from the same 15-min cache as GET /api/context — chat never blocks on a build.
# CONTEXT_LAT=1.4309
# CONTEXT_LON=103.7752
# CONTEXT_NAME=Woodlands Polycline (test clinic)

# Chat-model provider toggle (UI header): "openrouter" (the config above) vs
# "local" (your own OpenAI-compatible server, e.g. vLLM). The toggle only
# affects CHAT + brief — embeddings always use the config above, because the
# stored chroma_db was embedded with EMBED_MODEL and retrieval needs that
# same model. Set CHAT_PROVIDER to change the boot-time default.
# LOCAL_BASE_URL=http://10.8.0.9:9001/v1
# LOCAL_CHAT_MODEL=comp9:gpu0-vllm
# LOCAL_API_KEY=sk-no-key-required   (any non-empty value; keyless vLLM ignores it)
# LOCAL_DISABLE_THINKING=1   (vLLM Qwen3 thinking mode burns the max_tokens budget
#                             on reasoning and can return empty content; set 0 to re-enable)
# CHAT_PROVIDER=openrouter

